# Editor settings shared by the team (https://editorconfig.org)
# C++ layout rules live in .clang-format; line endings for scripts are enforced by .gitattributes
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h}]
max_line_length = 120

[*.md]
# Two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[*.sh]
end_of_line = lf

[*.bat]
end_of_line = crlf

[apps/desktop/libraries/**]
# Third-party code keeps its own formatting
charset = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
